# Authentication / 认证
SYSTEM_PASSWORD=
JWT_SECRET=
CONSOLE_SESSION_HOURS=168

# AI providers / AI 提供商
OPENAI_API_KEY=
# Optional OpenAI-compatible relay endpoint, for example https://api.example.com/v1
# 可选 OpenAI 兼容中转端点，例如 https://api.example.com/v1
OPENAI_API_BASE_URL=
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible relay endpoint.
# 可选 Anthropic 兼容中转端点。
ANTHROPIC_API_BASE_URL=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=
ACTIVE_AI_PROVIDER_ID=
# Optional per-model context/output limits as JSON objects.
# 可选的模型上下文窗口和输出上限覆盖，值为 JSON 对象。
# PROVIDER_CONTEXT_WINDOWS={"custom-model": 32000, "another-model": 64000}
# PROVIDER_OUTPUT_TOKENS={"custom-model": 2048}

# MVP defaults (optional -- used by the default daily-digest curator)
# MVP 默认配置（可选，供默认每日摘要精选 Agent 使用）
# Set the provider/model pair to Anthropic when using ANTHROPIC_API_KEY instead.
# 使用 ANTHROPIC_API_KEY 时，请改为匹配的 Anthropic provider/model 组合。
DEFAULT_CURATION_PROVIDER_ID=default-openai
DEFAULT_CURATION_MODEL=gpt-4o-mini
DEFAULT_CURATION_TEMPERATURE=0.3
DEFAULT_DIGEST_TARGETS=feishu_bot,wecom_bot
DEFAULT_DIGEST_TOP_N=12
DEFAULT_DIGEST_FETCH_DAYS=2
DEFAULT_DIGEST_ADAPTER_IDS=rss-adapter
# Optional per-schedule preview approval fields (configure in the schedule JSON, not Settings).
# 可选的按任务预览审核字段（配置在 schedule JSON 中，不在全局 Settings 中）。
# "preview_mode": "preview_first"
# "preview_targets": ["feishu_bot"]
# Consecutive adapter failures before automatic disablement (default: 3)
# 閫傞厤鍣ㄨ繛缁け璐ュ灏戞鍚庤嚜鍔ㄧ鐢紙榛樿锛?3锛夈€?ADAPTER_HEALTH_FAILURE_THRESHOLD=3
# Comma-separated publisher IDs to notify when an adapter is auto-disabled
# 閫傞厤鍣ㄨ嚜鍔ㄧ鐢ㄦ椂鎺ユ敹鍛婅鐨勫彂甯冨櫒 ID锛岀敤鑻辨枃閫楀彿鍒嗛殧銆?ADAPTER_HEALTH_ALERT_TARGETS=

# Comma-separated publisher IDs to notify for system metric alerts
# System 指标告警要通知的发布器 ID，使用英文逗号分隔
ALERT_TARGETS=

# Daily AI-news archive task. It runs at 09:00 Asia/Shanghai by default and only writes to the AI daily-news page.
# 每日 AI 资讯日报任务。默认在 Asia/Shanghai 时区的 09:00 运行，仅归档到 AI 资讯日报页面，不会自动推送。
DAILY_AI_NEWS_CRON=0 9 * * *
# Comma-separated AI-focused RSS/Atom feeds used by the scheduled archive task.
# 定时归档任务使用的 AI 定向 RSS/Atom 订阅源，使用英文逗号分隔。
DAILY_AI_NEWS_RSS_URLS=https://huggingface.co/blog/feed.xml,https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://aws.amazon.com/blogs/machine-learning/feed/,https://export.arxiv.org/rss/cs.AI,https://export.arxiv.org/rss/cs.CL,https://simonwillison.net/atom/everything/,https://github.blog/feed/
# Optional Follow OPML export. When set, subscribed feeds are fetched as another digest source.
# 可选的 Follow OPML 导出文件。配置后会抓取其中订阅源，作为额外日报来源。
DAILY_AI_NEWS_FOLLOW_OPML_PATH=
# Query used by the injected AI Search adapter when the default LLM provider is configured.
# 默认 LLM Provider 已配置时，AI Search 适配器使用的检索语句。
DAILY_AI_NEWS_SEARCH_QUERY=latest artificial intelligence, LLM, Agent, RAG, and open source AI news

# Publishers / 发布渠道
FEISHU_WEBHOOK=
FEISHU_SECRET=
WECOM_WEBHOOK=

# Scheduler distributed lock / 调度分布式锁
# Redis URL. Leave empty to make the lock unavailable (strict mode then skips execution).
# Redis 地址。留空表示锁不可用（严格模式下会拒绝执行）。
REDIS_URL=redis://localhost:6379/0
# Lock lease in seconds; 7200 seconds covers the daily digest workflow with crash recovery.
# 锁租约秒数；7200 秒覆盖每日推送并允许进程崩溃后自动释放。
SCHEDULER_LOCK_TTL_SECONDS=7200
# true: reject execution when Redis is unavailable; false: warn and execute without a lock.
# true：Redis 不可用时拒绝执行；false：告警后放行执行（存在重复推送风险）。
SCHEDULER_LOCK_STRICT_MODE=true

# Runtime / 运行时
# Database backend selection: sqlite or postgres
# 数据库后端选择：sqlite 或 postgres
DB_DRIVER=sqlite

# SQLite path; used when DB_DRIVER=sqlite
# SQLite 路径；DB_DRIVER=sqlite 时生效
DB_PATH=data/database.sqlite

# PostgreSQL DSN; used when DB_DRIVER=postgres
# PostgreSQL 连接串；DB_DRIVER=postgres 时生效
DATABASE_URL=

# PostgreSQL connection pool size
# PostgreSQL 连接池大小
DB_POOL_SIZE=5

# PostgreSQL pool acquire timeout in seconds
# PostgreSQL 连接池获取连接超时时间（秒）
DB_POOL_TIMEOUT=30.0
LOG_LEVEL=INFO
# Rotating runtime log file (10 MB each, 5 backups)
# 轮转运行日志文件（单文件 10 MB，保留 5 个备份）
LOG_FILE=logs/multiscribe-agent.log
# Optional outbound proxy for OpenAI and Anthropic, for example http://127.0.0.1:7890
# 可选 OpenAI 和 Anthropic 出站代理，例如 http://127.0.0.1:7890
HTTP_PROXY=
