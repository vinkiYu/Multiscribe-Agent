.env
.env.local
*.tsbuildinfo
data/
# Keep only checked-in curation baselines under the otherwise runtime-only data tree.
!data/
data/*
!data/eval/
data/eval/*
!data/eval/baselines/
data/eval/baselines/*
!data/eval/baselines/*.json
!data/eval/baselines/.gitkeep
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.benchmarks/
# pytest basetemp temporary artifacts (never commit generated test fixtures)
.tmp-pytest/
.pytest_tmp/
.pytest_tmp*/
.verify_tmp/
.ptmp/
.pytest-tmp/
.pytest-tmp-*/
.pytest-tmp-*-final/
.pytest-tmp-*-full/
.pytest-tmp-*-only/
.pytest-tmp-*-verify/
.pytest-tmp-*-debug/
.pytest-tmp-*-report/
.pytest-tmp-*-integration/
.pytest-tmp-*-recheck/
.pytest-tmp-*-offline/
.pytest-tmp-*-kb/
.pytest-tmp-*-no-kb/
dist/
*.egg-info/
node_modules/
logs/
# Migration reports contain local operational data and remain untracked.
logs/migration-*.json
# 临时文件/锁文件(测试或运行时产物;注意 uv.lock 必须提交,故不忽略 *.lock)
.commit-tmp/

# === Agent 执行与内部文档 (本地使用,不推 GitHub) ===
# Agent 执行prompt、review 记录
codex/
# 规划/设计/阶段文档保留本地；README 展示用截图位于 docs/pic/ 并推送。
# 治理文档(架构/ADR)按 AI Coding 工程规范入库,是 Agent 与人的共同契约。
docs/*
!docs/pic/
!docs/pic/*.png
!docs/architecture/
!docs/adr/
# Local release notes are kept for operator reference and never published.
docs/release-notes/
DESIGN.md

# === 本地开发产物 (不上传) ===
# SQLite 数据库文件
database.sqlite
*.db
*.sqlite3
# Agent 设计快照 / 产品评审文档
.impeccable/
FRONTEND_PRODUCT_UX_REVIEW.md
PRODUCT.md

# === 前端迁移遗留 (frontend 已搬到外层 prototype/) ===
# frontend 整目录的压缩备份，37MB，不入 git
frontend.zip
# 前端构建辅助脚本（本地用）
scripts/frontend_needs_build.ps1

# === IDE / 编辑器 ===
.idea/
